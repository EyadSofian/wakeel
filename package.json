{
  "name": "wakeel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "pnpm lint && turbo run typecheck test",
    "lint": "biome check . && node tools/lint-rules/tokens-only.ts",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:infra": "docker compose up --detach --wait --wait-timeout 120 && docker compose run --rm object-store-init",
    "dev:infra:down": "docker compose --profile init down",
    "dev:infra:reset": "docker compose --profile init down --volumes",
    "db:bootstrap": "tsx --env-file-if-exists=.env packages/db/src/cli/bootstrap.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/cli/migrate.ts",
    "ui:contrast": "node tools/contrast.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
