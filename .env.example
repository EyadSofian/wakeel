# Local development values for the stack started by `pnpm dev:infra`. Copy to .env (git-ignored).
# These passwords are for your machine only; never reuse them anywhere else.

# db:bootstrap (superuser from docker-compose.yml)
SUPERUSER_DATABASE_URL=postgres://postgres:postgres_dev_only@localhost:5432/wakeel
APP_MIGRATOR_PASSWORD=migrator_dev_only_pw
APP_RW_PASSWORD=app_rw_dev_only_pw_1
APP_ADMIN_RO_PASSWORD=admin_ro_dev_only_pw

# db:migrate
MIGRATOR_DATABASE_URL=postgres://app_migrator:migrator_dev_only_pw@localhost:5432/wakeel

# api and worker
DATABASE_URL=postgres://app_rw:app_rw_dev_only_pw_1@localhost:5432/wakeel
REDIS_URL=redis://localhost:6379

# Object store (RustFS, ADR-013). docker-compose creates the bucket. Read by the
# object store client added in Phase 8.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wakeel-dev
S3_ACCESS_KEY_ID=wakeel_dev
S3_SECRET_ACCESS_KEY=wakeel_dev_only_secret
