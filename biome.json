{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!docs",
      "!**/*.md",
      "!**/.turbo",
      "!**/coverage",
      "!**/dist",
      "!examples/bridge-receiver-node/src/verify.mjs"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noDefaultExport": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "pg": "Raw database connections skip tenant isolation. Use withWorkspace from @wakeel/db.",
              "pg-pool": "Raw database connections skip tenant isolation. Use withWorkspace from @wakeel/db.",
              "postgres": "Raw database connections skip tenant isolation. Use withWorkspace from @wakeel/db.",
              "drizzle-orm/node-postgres": "Raw database connections skip tenant isolation. Use withWorkspace from @wakeel/db.",
              "drizzle-orm/postgres-js": "Raw database connections skip tenant isolation. Use withWorkspace from @wakeel/db."
            }
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case", "PascalCase"],
                "requireAscii": true
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.mts",
        "**/*.config.js",
        "**/vitest.workspace.ts",
        "**/playwright.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
